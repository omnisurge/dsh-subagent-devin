{
  "name": "@omnisurge/dsh-subagent-devin",
  "version": "0.1.0-1",
  "private": true,
  "type": "module",
  "description": "Devin as a DeepSeek Harness subagent provider, authenticated from the credential service.",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "test": "node --test test/provider.test.mjs test/probe.test.mjs test/cli.test.mjs test/client-contract.test.mjs test/client-render.test.mjs",
    "mutations": "sh scripts/mutations.sh"
  }
}
